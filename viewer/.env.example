# ── Company Brain Viewer — environment variables ──────────────────────────────
#
# Copy to .env for local API. NEVER commit secrets.

# MinIO (S3-compatible) — sole runtime store for 01-COMPANY … 10-OUTPUTS
# Production example: khoadue.me:9000 with MINIO_SECURE=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=company-brain
MINIO_SECURE=false

# Fixture / offline only (used when MINIO_* is unset — prefer MinIO for real use)
# BRAIN_ROOT=/path/to/company-brain

# App-level session auth (required for API + UI)
VIEWER_AUTH_USER=
VIEWER_AUTH_PASSWORD=
# At least 32 random characters
VIEWER_SESSION_SECRET=

# Optional
# VIEWER_API_PORT=8787
# VIEWER_API_HOST=127.0.0.1
# Comma-separated allowed browser origins (credentials CORS). Defaults include Vite local.
# VIEWER_CORS_ORIGIN=https://company-brain-viewer.vercel.app

# Neo4j knowledge graph (Bolt)
# URI may also be set as NEO4J_DBMS
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
